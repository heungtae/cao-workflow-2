{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "repo",
    "issue_number",
    "author",
    "origin_id",
    "event_id",
    "body",
    "risk",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "origin_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "issue_number": {
      "type": "integer",
      "minimum": 1
    },
    "risk": {
      "enum": [
        "low",
        "high",
        "unknown"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
