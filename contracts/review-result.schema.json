{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "status",
    "head_sha",
    "findings"
  ],
  "properties": {
    "status": {
      "enum": [
        "PASS",
        "CHANGES_REQUIRED",
        "BLOCKED_SPEC",
        "FAILED"
      ]
    },
    "head_sha": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "thread_id",
          "comment_id",
          "type",
          "priority",
          "file",
          "line",
          "head_sha",
          "requirement_id",
          "expected_behavior",
          "suggested_fix"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "head_sha": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "expected_behavior": {
            "type": "string",
            "minLength": 1
          },
          "suggested_fix": {
            "type": "string",
            "minLength": 1
          },
          "thread_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "comment_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "side": {
            "enum": [
              "LEFT",
              "RIGHT"
            ]
          }
        }
      }
    }
  }
}
